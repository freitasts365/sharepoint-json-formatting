{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "align-items": "stretch",
      "justify-content": "space-between",
      "width": "100%",
      "padding": "22px 24px",
      "box-sizing": "border-box",
      "background-color": "#F5F1E8",
      "border": "1px solid #E2D5BC",
      "border-radius": "10px"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "width": "50%",
          "display": "flex",
          "flex-direction": "column",
          "justify-content": "center",
          "padding-right": "22px",
          "box-sizing": "border-box"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "EXCHANGE RATE",
            "style": {
              "font-size": "11px",
              "font-weight": "700",
              "color": "#0B2D55",
              "letter-spacing": "0.5px",
              "margin-bottom": "8px"
            }
          },
          {
            "elmType": "div",
            "txtContent": "='R$ ' + [$Title]",
            "style": {
              "font-size": "30px",
              "font-weight": "700",
              "color": "#0B2D55",
              "line-height": "36px",
              "white-space": "nowrap"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "width": "1px",
          "min-height": "64px",
          "background-color": "#D8C8AA",
          "flex-shrink": "0"
        }
      },
      {
        "elmType": "div",
        "style": {
          "width": "50%",
          "display": "flex",
          "flex-direction": "column",
          "justify-content": "center",
          "padding-left": "22px",
          "box-sizing": "border-box"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "MRV FEE",
            "style": {
              "font-size": "11px",
              "font-weight": "700",
              "color": "#0B2D55",
              "letter-spacing": "0.5px",
              "margin-bottom": "8px"
            }
          },
          {
            "elmType": "div",
            "txtContent": "=if([$MRVFee] == '', 'Not available', 'R$ ' + [$MRVFee])",
            "style": {
              "font-size": "30px",
              "font-weight": "700",
              "color": "#0B2D55",
              "line-height": "36px",
              "white-space": "nowrap"
            }
          }
        ]
      }
    ]
  }
}
